<?xml version="1.0" encoding="utf-8"?>
<!--
  Config por defecto para TODOS los builds (release incluido). No permite cleartext bajo
  ninguna circunstancia. Para desarrollo local con backend http://, ver el override en
  src/debug/res/xml/network_security_config.xml — Gradle lo usa automáticamente en vez de
  este archivo cuando el build es debuggable, sin afectar builds de release/producción.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
