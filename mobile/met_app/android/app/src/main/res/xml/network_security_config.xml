<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP (sin TLS) SOLO hacia el backend de desarrollo, y SOLO en
  builds debuggable (debug-overrides no aplica en un release/producción firmado).
  El API_BASE_URL de desarrollo es http://, no https:// — sin esto, Android
  bloquea la conexión con "CLEARTEXT communication not permitted" desde la
  versión 9 (API 28) en adelante.

  Si cambias de red Wi-Fi y tu IP deja de ser 192.168.1.34, agrega la nueva IP
  aquí también (o usa 10.0.2.2 para el emulador, ya incluido).
-->
<network-security-config>
    <debug-overrides>
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">192.168.1.34</domain>
            <domain includeSubdomains="false">10.0.2.2</domain>
            <domain includeSubdomains="false">localhost</domain>
        </domain-config>
    </debug-overrides>
</network-security-config>
