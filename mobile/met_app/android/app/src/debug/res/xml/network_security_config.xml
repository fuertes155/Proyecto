<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para builds debuggable: este archivo vive en src/debug/, así que Gradle lo usa
  ÚNICAMENTE en compilaciones debug, reemplazando por completo al de src/main/ (release
  usa el estricto, sin excepciones de cleartext).

  Permite tráfico HTTP (sin TLS) SOLO hacia el backend de desarrollo. El API_BASE_URL de
  desarrollo es http://, no https:// — sin esto, Android bloquea la conexión con
  "CLEARTEXT communication not permitted" desde la versión 9 (API 28) en adelante.

  Si cambias de red Wi-Fi y tu IP deja de ser 192.168.1.34, agrega la nueva IP aquí
  también (o usa 10.0.2.2 para el emulador, ya incluido).

  NOTA: <domain-config> va a nivel raíz, NO dentro de <debug-overrides> — ese elemento
  solo admite <trust-anchors>; anidar <domain-config> ahí revienta el parser en runtime
  con "Nested domain-config not allowed in debug-overrides".
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.102</domain>
        <domain includeSubdomains="false">192.168.1.34</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!--
      Fallback: este archivo solo aplica a builds debug. Permitir cleartext hacia
      cualquier host en debug evita tener que editar esta lista cada vez que cambia
      la IP/red del PC de desarrollo. El build de release sigue usando el config
      estricto de src/main/ (sin cleartext).
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
