# ============================================================
#  Met Platform — Variables de Entorno
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=met
POSTGRES_USER=met
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_CONTRASEÑA_SEGURA

# --- Redis ---
REDIS_PASSWORD=CAMBIA_ESTO_POR_UNA_CONTRASEÑA_REDIS_SEGURA

# --- JWT (mínimo 256 bits, al menos 32 caracteres aleatorios) ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_JWT_DE_256_BITS_MINIMO

# --- AES-256 (exactamente 32 caracteres) ---
# Genera uno con: openssl rand -base64 24
AES_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_AES_DE_32!

# --- Notification Service (API Key interna entre servicios) ---
# Genera uno con: openssl rand -hex 16
NOTIFICATION_API_KEY=CAMBIA_ESTO_POR_UNA_API_KEY_ALEATORIA

# --- CORS (orígenes permitidos separados por coma) ---
CORS_ORIGINS=http://localhost:3000

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Compliance ---
COMPLIANCE_ENTITY_CODE=COOP001
