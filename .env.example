# ============================================================
#  Met Platform — Variables de Entorno
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- PostgreSQL (Las contraseñas están en Vault) ---
POSTGRES_DB=met
POSTGRES_USER=met

# --- HashiCorp Vault (Secret Manager) ---
# En desarrollo usa "root" (por defecto del contenedor docker de pruebas)
# En producción este token lo provee el orquestador (K8s) o IAM (AWS).
VAULT_TOKEN=root

# --- CORS (orígenes permitidos separados por coma) ---
# Acepta patrones: http://localhost:* cubre el puerto aleatorio de `flutter run -d chrome`.
CORS_ORIGINS=http://localhost:*

# --- Notification Service ---
# Debe coincidir con el valor NOTIFICATION_API_KEY guardado en Vault.
NOTIFICATION_API_KEY=notification_dev_key

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Compliance ---
COMPLIANCE_ENTITY_CODE=COOP001

# --- DataCrédito Experian ---
CREDIT_BUREAU_PROVIDER=mock
DATACREDITO_API_URL=https://api.experian.com.co
DATACREDITO_CLIENT_ID=
DATACREDITO_CLIENT_SECRET=
