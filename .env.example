# ============================================================
#  Met Platform — Variables de Entorno
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- PostgreSQL (Las contraseñas están en Vault) ---
POSTGRES_DB=met
POSTGRES_USER=met

# --- HashiCorp Vault (Secret Manager) ---
# En desarrollo usa "root" (por defecto del contenedor docker de pruebas)
# En producción este token lo provee el orquestador (K8s) o IAM (AWS).
VAULT_TOKEN=root

# --- CORS (orígenes permitidos separados por coma) ---
# Acepta patrones: http://localhost:* cubre el puerto aleatorio de `flutter run -d chrome`.
CORS_ORIGINS=http://localhost:*

# --- Notification Service ---
# Debe coincidir con el valor NOTIFICATION_API_KEY guardado en Vault.
NOTIFICATION_API_KEY=notification_dev_key

# --- Spring Profile ---
# dev = pasarela de pago simulada · dev,sandbox = sandbox REAL de Wompi (ver application-sandbox.yml)
SPRING_PROFILES_ACTIVE=dev

# --- Wompi (dashboard.wompi.co → Desarrolladores) ---
# Sandbox: llaves pub_test_/prv_test_ y secretos test_integrity_/test_events_.
# Estas variables tienen prioridad sobre los valores de ejemplo que setup_vault_dev guarda en Vault.
WOMPI_PUBLIC_KEY=pub_test_REPLACE_ME
WOMPI_PRIVATE_KEY=prv_test_REPLACE_ME
# Secretos para integración técnica → Integridad
WOMPI_INTEGRITY_SECRET=test_integrity_REPLACE_ME
# Secretos para integración técnica → Eventos (valida el checksum de los webhooks)
WOMPI_WEBHOOK_SECRET=test_events_REPLACE_ME
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# URL pública del backend + /api/v1/payments/wompi/return (túnel o Render)
WOMPI_REDIRECT_URL=

# --- Compliance ---
COMPLIANCE_ENTITY_CODE=COOP001

# --- DataCrédito Experian ---
CREDIT_BUREAU_PROVIDER=mock
DATACREDITO_API_URL=https://api.experian.com.co
DATACREDITO_CLIENT_ID=
DATACREDITO_CLIENT_SECRET=
