package com.cooperativa.met.application.bank.usecase;

import com.cooperativa.met.application.bank.dto.ExternalBankAccountResponse;
import com.cooperativa.met.application.bank.dto.RegisterExternalBankAccountRequest;
import com.cooperativa.met.domain.bank.model.Bank;
import com.cooperativa.met.domain.bank.model.BankAccountVerificationStatus;
import com.cooperativa.met.domain.bank.model.ExternalBankAccount;
import com.cooperativa.met.domain.bank.port.BankRepositoryPort;
import com.cooperativa.met.domain.bank.port.ExternalBankAccountRepositoryPort;
import com.cooperativa.met.domain.common.exception.BusinessRuleException;
import com.cooperativa.met.domain.common.exception.ResourceNotFoundException;
import com.cooperativa.met.domain.identity.model.KycStatus;
import com.cooperativa.met.domain.identity.model.User;
import com.cooperativa.met.domain.identity.port.UserRepositoryPort;
import com.cooperativa.met.infrastructure.audit.AuditLogService;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.Instant;
import java.util.UUID;

/**
 * Registra una cuenta bancaria externa propia del usuario para usarla como
 * destino de payouts. No hay verificación de titularidad activa hoy (ver
 * discusión de arquitectura: micro-depósito vs. consulta de titularidad
 * quedó pendiente de definición con riesgo/cumplimiento) — la garantía de
 * "cuenta propia" la da {@link com.cooperativa.met.application.bank.usecase.ExecuteExternalPayoutUseCase},
 * que SIEMPRE envía al riel la identidad KYC del usuario autenticado como
 * beneficiario, nunca un dato capturado aquí. El estado de verificación
 * queda en PENDING como marcador para un futuro control manual/adicional.
 */
@Service
@RequiredArgsConstructor
public class RegisterExternalBankAccountUseCase {

    private final UserRepositoryPort userRepository;
    private final BankRepositoryPort bankRepository;
    private final ExternalBankAccountRepositoryPort externalBankAccountRepository;
    private final AuditLogService auditLogService;

    @Transactional
    public ExternalBankAccountResponse execute(UUID userId, RegisterExternalBankAccountRequest request) {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new ResourceNotFoundException("Usuario no encontrado"));

        if (user.getKycStatus() != KycStatus.APPROVED) {
            throw new BusinessRuleException("KYC_REQUIRED",
                    "Debe completar la validación de identidad para registrar una cuenta bancaria");
        }

        Bank bank = bankRepository.findByCode(request.bankCode())
                .orElseThrow(() -> new ResourceNotFoundException("Banco no encontrado"));

        if (!bank.isActive() || !bank.isSupportsPayout()) {
            throw new BusinessRuleException("BANK_NOT_SUPPORTED",
                    "El banco seleccionado no está disponible para retiros en este momento");
        }

        ExternalBankAccount account = ExternalBankAccount.builder()
                .id(UUID.randomUUID())
                .userId(userId)
                .bankCode(bank.getCode())
                .accountType(request.accountType())
                .accountNumber(request.accountNumber())
                .verificationStatus(BankAccountVerificationStatus.PENDING)
                .active(true)
                .createdAt(Instant.now())
                .build();

        ExternalBankAccount saved = externalBankAccountRepository.save(account);

        auditLogService.logSuccess(userId, "EXTERNAL_BANK_ACCOUNT_REGISTERED", "EXTERNAL_BANK_ACCOUNT",
                saved.getId().toString(),
                String.format("{\"bankCode\":\"%s\",\"accountType\":\"%s\"}", bank.getCode(), request.accountType()));

        return toResponse(saved, bank);
    }

    private ExternalBankAccountResponse toResponse(ExternalBankAccount account, Bank bank) {
        String number = account.getAccountNumber();
        String masked = number.length() > 4
                ? "*".repeat(number.length() - 4) + number.substring(number.length() - 4)
                : number;

        return ExternalBankAccountResponse.builder()
                .id(account.getId())
                .bankCode(bank.getCode())
                .bankName(bank.getName())
                .accountType(account.getAccountType())
                .maskedAccountNumber(masked)
                .verificationStatus(account.getVerificationStatus())
                .createdAt(account.getCreatedAt())
                .build();
    }
}
